{
  "name": "chineseidiomsgame",
  "private": true,
  "version": "1.0.1",
  "description": "《貓咪成語大冒險》— 貓貓風格成語填字／接龍網頁遊戲（100 關，繁體中文）",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5280",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4280",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "generate:levels": "node scripts/generate-levels.mjs",
    "verify:idioms": "node scripts/verify-idioms.mjs",
    "verify:levels": "node scripts/verify-levels.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "shots": "node scripts/qa-screenshots.mjs",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/ci-build.mjs",
    "verify:live": "node scripts/lead-live-check.mjs"
  },
  "author": "DSH Agent Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
